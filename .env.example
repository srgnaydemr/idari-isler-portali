# MySQL 8.4 zorunludur. Önce boş bir veritabanı oluşturun.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=portal_app
MYSQL_PASSWORD=
MYSQL_DATABASE=idari_isler
MYSQL_POOL_SIZE=5
# Uzak sunucu için doğrulanan TLS sertifikası (isteğe bağlı):
# MYSQL_SSL_CA=/guvenli/yol/ca.pem
# MYSQL_URL=mysql://kullanici:parola@sunucu:3306/idari_isler alternatif olarak kullanılabilir.

# Kalıcı dosya yolları. Production/Railway gibi ephemeral hostinglerde bu yolu kalıcı volume'a bağlayın.
# Mevcut uploads ve branding dosyalarınızı koruyun.
PORTAL_DATA_DIR=./storage
PORTAL_UPLOAD_DIR=./storage/uploads
PORTAL_BACKUP_DIR=./storage/backups
PORTAL_MAX_UPLOAD_MB=25
# HTTPS production ortamında belirtilmezse otomatik true kabul edilir.
# Yalnızca HTTPS olmayan geliştirme ortamında gerekirse false yapın.
PORTAL_COOKIE_SECURE=true

# QR kodlarının açacağı kalıcı canlı portal adresi (önerilir)
# Örnek: https://portal.sirketiniz.com
PORTAL_PUBLIC_URL=
